# FARO — variables de entorno (copiar a .env y llenar). NUNCA commitear .env.

# Contacto para el User-Agent del scraping (OPCIONAL; cortesía, no obligatorio).
FARO_CONTACTO=

# Fecha de referencia (corte del snapshot). Formato ISO.
FARO_FECHA_REFERENCIA=2026-09-30T23:59:00-05:00

# Rutas relativas a la raíz del repo (opcional; por defecto usa data/).
FARO_DATA_DIR=data
FARO_DB=data/faro.db

# Proveedor LLM por defecto (usuario | local | auto)
FARO_LLM_MODO=auto
FARO_LLM_PROVEEDOR=
FARO_LLM_MODELO=
FARO_LLM_API_KEY=
FARO_LLM_BASE_URL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
FARO_OLLAMA_MODELO=qwen2.5:7b-instruct

# Notion
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Flags de entorno (WP-2 / WP-1.7). NO activar en la demo.
# Permite datos sintéticos solo en pruebas (default 0).
FARO_PERMITIR_SINTETICO=0
# Permite el fallback por hashing/regex solo en pruebas (default 0).
FARO_PERMITIR_FALLBACK=0
# Modo offline para modelos (poner 1 en make run / demo-offline después del setup).
HF_HUB_OFFLINE=0
